---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Get in touch with Ionel Silviu Ghimpau by email, GitHub, or LinkedIn.">
	<section class="page-hero contact-hero">
		<div class="shell contact-layout">
			<div class="contact-copy" data-reveal>
				<p class="eyebrow">Contact</p>
				<h1 class="display-1">Let’s talk.</h1>
				<p class="lead">
					If you have a question about one of my tools, want to compare notes on a network problem, or noticed something I could improve, feel free to write.
				</p>
				<p class="contact-note">Email is the simplest way to reach me. I read every message and reply when I can.</p>

				<a class="primary-email" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
					<span class="email-label">Email me</span>
					<span class="email-address">
						<strong>{site.email}</strong>
						<span class="email-arrow" aria-hidden="true">→</span>
					</span>
				</a>

				<p class="language-note">
					<span>Languages</span>
					English · Nederlands · Română
				</p>
			</div>

			<figure class="contact-portrait" data-reveal style="--reveal-delay:.08s">
				<img
					src="/assets/silviu-ghimpau.jpg"
					alt="Portrait of Ionel Silviu Ghimpau"
					width="460"
					height="460"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</figure>
		</div>
	</section>

	<section class="contact-links-section" aria-labelledby="contact-links-title">
		<div class="shell contact-links-layout">
			<header class="contact-links-heading" data-reveal>
				<p class="section-label">Other places</p>
				<h2 id="contact-links-title">You can also find me here.</h2>
				<p>Choose the place that fits the conversation.</p>
			</header>

			<div class="contact-list">
				<a href={site.github} target="_blank" rel="noreferrer" data-reveal>
					<span class="contact-index">01</span>
					<div class="contact-method">
						<h3>GitHub</h3>
						<p>Source code, releases, and discussions that belong with a project.</p>
					</div>
					<span class="contact-handle">@{site.githubHandle}</span>
					<span class="contact-arrow" aria-hidden="true">↗</span>
				</a>

				<a href={site.linkedin} target="_blank" rel="noreferrer" data-reveal style="--reveal-delay:.06s">
					<span class="contact-index">02</span>
					<div class="contact-method">
						<h3>LinkedIn</h3>
						<p>Professional introductions, project conversations, and collaboration.</p>
					</div>
					<span class="contact-handle">@{site.linkedinHandle}</span>
					<span class="contact-arrow" aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.contact-hero {
		padding-bottom: clamp(4rem, 7vw, 6rem);
	}

	.contact-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(13rem, 16rem);
		gap: clamp(3rem, 10vw, 8.5rem);
		align-items: center;
	}

	.contact-copy {
		display: grid;
		justify-items: start;
		gap: 1.05rem;
		max-width: 46rem;
	}

	.contact-copy .display-1 {
		max-width: 12ch;
	}

	.contact-copy .lead {
		max-width: 61ch;
	}

	.contact-note {
		max-width: 56ch;
		font-size: 0.96rem;
		color: var(--text-soft);
	}

	.primary-email {
		display: grid;
		gap: 0.45rem;
		width: min(100%, 32rem);
		margin-top: 0.7rem;
		padding: 1rem 0 0.9rem;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line-strong);
		transition: border-color 0.25s var(--ease), opacity 0.25s var(--ease);
	}

	.primary-email:hover {
		border-bottom-color: var(--text-soft);
	}

	.primary-email:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 5px;
	}

	.email-label,
	.language-note,
	.section-label,
	.contact-index,
	.contact-handle {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--text-faint);
	}

	.email-label,
	.section-label {
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.email-address {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-width: 0;
	}

	.email-address strong {
		font-family: var(--font-display);
		font-size: clamp(1.12rem, 2.2vw, 1.4rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.email-arrow {
		flex: 0 0 auto;
		font-size: 1.15rem;
		color: var(--text-soft);
		transition: transform 0.25s var(--ease), color 0.25s var(--ease);
	}

	.primary-email:hover .email-arrow,
	.primary-email:focus-visible .email-arrow {
		color: var(--text);
		transform: translateX(4px);
	}

	.language-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0.9rem;
		margin-top: 0.25rem;
	}

	.language-note > span {
		color: var(--text-soft);
	}

	.contact-portrait {
		position: relative;
		justify-self: end;
		width: min(100%, 15rem);
		aspect-ratio: 1;
		padding: 0.35rem;
		border: 1px solid color-mix(in srgb, var(--line-strong) 82%, transparent);
		border-radius: 50%;
		background: color-mix(in srgb, var(--surface) 68%, transparent);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.035),
			0 24px 54px -40px rgba(0, 0, 0, 0.9);
	}

	.contact-portrait img {
		width: 100%;
		height: 100%;
		border-radius: inherit;
		object-fit: cover;
		object-position: 50% 38%;
		filter: saturate(0.9) contrast(1.02);
	}

	.contact-links-section {
		position: relative;
		padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(4.5rem, 9vw, 7.5rem);
	}

	.contact-links-section::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		width: min(var(--shell), calc(100% - 2.5rem));
		height: 1px;
		transform: translateX(-50%);
		background: linear-gradient(90deg, transparent, var(--line-strong) 12%, var(--line) 88%, transparent);
	}

	.contact-links-layout {
		display: grid;
		grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 9vw, 8rem);
		align-items: start;
	}

	.contact-links-heading h2 {
		max-width: 12ch;
		margin-top: 1rem;
		font-size: clamp(1.8rem, 3.4vw, 2.8rem);
		letter-spacing: -0.035em;
	}

	.contact-links-heading > p:last-child {
		max-width: 35ch;
		margin-top: 1rem;
		font-size: 0.96rem;
		color: var(--text-soft);
	}

	.contact-list {
		display: grid;
	}

	.contact-list > a {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) minmax(7.5rem, 0.38fr) auto;
		gap: clamp(0.85rem, 2.5vw, 1.5rem);
		align-items: start;
		padding: 1.45rem 0 1.65rem;
		transition: opacity 0.2s var(--ease);
	}

	.contact-list > a::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, var(--line-strong), var(--line) 72%, transparent);
	}

	.contact-list > a:last-child::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: linear-gradient(90deg, var(--line), transparent);
	}

	.contact-list > a:hover {
		opacity: 0.78;
	}

	.contact-list > a:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 5px;
	}

	.contact-index,
	.contact-handle {
		padding-top: 0.2rem;
	}

	.contact-method {
		display: grid;
		gap: 0.4rem;
	}

	.contact-method h3 {
		font-size: 1.16rem;
	}

	.contact-method p {
		max-width: 48ch;
		font-size: 0.92rem;
		color: var(--text-soft);
	}

	.contact-handle {
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.contact-arrow {
		padding-top: 0.08rem;
		color: var(--text-faint);
		transition: transform 0.25s var(--ease), color 0.25s var(--ease);
	}

	.contact-list > a:hover .contact-arrow,
	.contact-list > a:focus-visible .contact-arrow {
		color: var(--text);
		transform: translate(2px, -2px);
	}

	:global(:root[data-theme='light']) .contact-portrait {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.65),
			0 24px 54px -40px rgba(38, 42, 47, 0.25);
	}

	@media (max-width: 860px) {
		.contact-layout,
		.contact-links-layout {
			grid-template-columns: 1fr;
		}

		.contact-layout {
			gap: 2.75rem;
		}

		.contact-copy {
			grid-row: 2;
		}

		.contact-portrait {
			grid-row: 1;
			justify-self: start;
			width: clamp(9.5rem, 38vw, 11.5rem);
		}

		.contact-links-layout {
			gap: 2.5rem;
		}

		.contact-list > a {
			grid-template-columns: 2.25rem minmax(0, 1fr) auto;
		}

		.contact-handle {
			grid-column: 2;
			grid-row: 2;
			padding-top: 0;
		}

		.contact-arrow {
			grid-column: 3;
			grid-row: 1 / span 2;
		}
	}

	@media (max-width: 480px) {
		.contact-hero {
			padding-bottom: 3.75rem;
		}

		.contact-layout {
			gap: 2.25rem;
		}

		.contact-list > a {
			grid-template-columns: 1.9rem minmax(0, 1fr) auto;
			gap: 0.7rem;
		}
	}
</style>
