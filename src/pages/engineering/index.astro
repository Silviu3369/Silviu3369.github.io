---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { engineeringProjects, labProjects } from '../../data/site';
---

<BaseLayout
	title="Engineering"
	description="Cisco network architectures, infrastructure automation, and systems research — documented as complete systems."
>
	<section class="page-hero">
		<div class="shell page-hero-inner" data-reveal>
			<p class="eyebrow">Engineering</p>
			<h1 class="display-1">How I explore networks and automation.</h1>
			<p class="lead">
				These projects are where I work through routing, security, redundancy, identity, and automation. I keep the diagrams and decisions together so the result is more useful than a lab file on its own.
			</p>
			<div class="meta-row">
				<span class="chip">Cisco</span>
				<span class="chip">Windows infrastructure</span>
				<span class="chip">Automation</span>
				<span class="chip">Research</span>
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="shell eng-catalog">
			{engineeringProjects.map((project, index) => (
				<a
					class="card card-hover eng-item"
					href={`/engineering/${project.slug}/`}
					style={`--accent:${project.accent}`}
					data-reveal
				>
					<div class="eng-item-media" aria-hidden="true">
						{project.image ? (
							<img src={project.image} alt="" loading="lazy" />
						) : (
							<div class="eng-item-pattern"></div>
						)}
						<span class="eng-index">0{index + 1}</span>
					</div>
					<div class="eng-item-copy">
						<span class="chip">{project.category}</span>
						<h2>{project.name}</h2>
						<p>{project.description}</p>
						<div class="eng-item-tech">
							{project.technologies.slice(0, 5).map((tech) => <span class="chip">{tech}</span>)}
						</div>
						<span class="text-link">See the project <span class="arr" aria-hidden="true">→</span></span>
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="section-tight">
		<div class="shell">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Side projects</p>
				<h2 class="display-2">Things I explore to keep learning.</h2>
			</div>
			<div class="lab-grid">
				{labProjects.map((lab, index) => (
					<a
						class:list={['card', 'card-hover', 'lab-card', { 'lab-card--featured': lab.featured }]}
						href={lab.url}
						target="_blank"
						rel="noreferrer"
						data-reveal
						style={`--reveal-delay:${index * 0.08}s;${lab.accent ? `--accent:${lab.accent}` : ''}`}
					>
						<div class="lab-card-head">
							<span class="chip">{lab.type}</span>
							{lab.status && <span class="lab-status">{lab.status}</span>}
						</div>
						<div class="lab-title-row">
							{lab.logo && <img class="lab-title-logo" src={lab.logo} alt="" width="384" height="384" loading="lazy" decoding="async" />}
							<h3>{lab.name}</h3>
						</div>
						<p>{lab.description}</p>
						<span class="text-link">{lab.linkLabel ?? 'Take a look'} <span class="arr" aria-hidden="true">↗</span></span>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.eng-catalog {
		display: grid;
		gap: 1.6rem;
	}

	.eng-item {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		overflow: hidden;
	}

	.eng-item-media {
		position: relative;
		min-height: 280px;
		border-right: 1px solid var(--line);
		overflow: hidden;
	}

	.eng-item-media img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		padding: 0.45rem;
		background: #f6f7f8;
		filter: saturate(0.9) brightness(0.88);
		transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
	}

	.eng-item:hover .eng-item-media img {
		transform: scale(1.03);
		filter: saturate(1) brightness(1);
	}

	.eng-item-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, transparent 55%, rgba(5, 6, 10, 0.55));
		pointer-events: none;
	}

	.eng-item-pattern {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(24rem 16rem at 70% 20%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 65%),
			linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
		background-size: auto, 36px 36px, 36px 36px;
	}

	.eng-item-pattern::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle 4px at 22% 38%, var(--accent) 40%, transparent 41%),
			radial-gradient(circle 4px at 48% 68%, var(--accent) 40%, transparent 41%),
			radial-gradient(circle 4px at 72% 32%, var(--accent) 40%, transparent 41%),
			radial-gradient(circle 4px at 84% 62%, var(--accent) 40%, transparent 41%);
		opacity: 0.75;
	}

	.eng-index {
		position: absolute;
		top: 1.1rem;
		left: 1.1rem;
		z-index: 1;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.12em;
		color: var(--text-soft);
		padding: 0.3rem 0.65rem;
		border-radius: 99px;
		border: 1px solid var(--line);
		background: rgba(5, 6, 10, 0.65);
		backdrop-filter: blur(10px);
	}

	.eng-item-copy {
		display: grid;
		gap: 0.85rem;
		padding: clamp(1.6rem, 3.4vw, 2.4rem);
		align-content: center;
		justify-items: start;
	}

	.eng-item-copy h2 {
		font-size: clamp(1.45rem, 2.6vw, 1.9rem);
	}

	.eng-item-copy > p {
		color: var(--text-soft);
		font-size: 0.97rem;
		max-width: 52ch;
	}

	.eng-item-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-block: 0.2rem 0.3rem;
	}

	.lab-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2rem;
	}

	.lab-card {
		display: grid;
		gap: 0.7rem;
		padding: 1.6rem;
		align-content: start;
		justify-items: start;
		min-width: 0;
	}

	.lab-card--featured {
		--lab-mark-right: clamp(2.5rem, 6vw, 5rem);
		--lab-mark-size: clamp(9.5rem, 15vw, 12rem);
		grid-column: 1 / -1;
		min-height: 14rem;
		position: relative;
		overflow: hidden;
		padding: clamp(1.8rem, 4vw, 2.4rem) clamp(15rem, 24vw, 20rem) clamp(1.8rem, 4vw, 2.4rem) clamp(1.8rem, 4vw, 2.4rem);
		background:
			radial-gradient(30rem 18rem at 92% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%),
			linear-gradient(145deg, color-mix(in srgb, var(--surface-strong) 94%, transparent), var(--surface));
	}

	.lab-title-row {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-width: 0;
	}

	.lab-title-logo {
		position: absolute;
		top: 50%;
		right: var(--lab-mark-right);
		width: var(--lab-mark-size);
		height: auto;
		transform: translateY(-50%);
		opacity: 0.82;
		filter: saturate(0.88) drop-shadow(0 20px 28px rgba(0, 0, 0, 0.24));
		transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
		pointer-events: none;
	}

	.lab-card--featured:hover .lab-title-logo {
		opacity: 0.92;
		transform: translateY(-50%) scale(1.025);
	}

	.lab-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		width: 100%;
	}

	.lab-card-head .chip {
		max-width: 100%;
		white-space: normal;
		line-height: 1.35;
	}

	.lab-status {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.lab-card--featured .lab-status {
		position: absolute;
		top: clamp(1.8rem, 4vw, 2.4rem);
		right: var(--lab-mark-right);
		width: var(--lab-mark-size);
		text-align: center;
	}

	.lab-card h3 {
		font-size: 1.25rem;
	}

	.lab-card--featured h3 {
		font-size: clamp(1.55rem, 3vw, 2rem);
	}

	.lab-card p {
		font-size: 0.9rem;
		color: var(--text-soft);
	}

	.lab-card--featured p {
		max-width: 62ch;
		font-size: 0.97rem;
	}

	@media (max-width: 900px) {
		.eng-item {
			grid-template-columns: 1fr;
		}

		.eng-item-media {
			min-height: 200px;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.lab-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.lab-card--featured {
			--lab-mark-right: clamp(2rem, 5vw, 3rem);
			--lab-mark-size: clamp(8rem, 20vw, 10rem);
			padding-right: clamp(11rem, 28vw, 14rem);
		}
	}

	@media (max-width: 680px) {
		.lab-card--featured {
			min-height: 0;
			padding: 1.6rem;
		}

		.lab-title-row {
			align-items: center;
		}

		.lab-title-logo {
			position: static;
			flex: 0 0 auto;
			width: 3.85rem;
			transform: none;
			opacity: 0.9;
			filter: saturate(0.9) drop-shadow(0 10px 16px rgba(0, 0, 0, 0.2));
		}

		.lab-card--featured .lab-status {
			position: static;
			width: auto;
			text-align: left;
		}

		.lab-card--featured:hover .lab-title-logo {
			transform: scale(1.025);
		}
	}

	@media (max-width: 420px) {
		.lab-card--featured {
			padding: 1.5rem;
		}
	}
</style>
