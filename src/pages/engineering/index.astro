---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { engineeringProjects, labProjects } from '../../data/site';

const collaborativeProject = labProjects.find((project) => project.featured);
const experiments = labProjects.filter((project) => !project.featured);
---

<BaseLayout
	title="Engineering"
	description="Cisco network architectures, infrastructure automation, and collaborative systems engineering documented by Ionel Silviu Ghimpau."
>
	<section class="page-hero">
		<div class="shell engineering-hero" data-reveal>
			<p class="eyebrow">Engineering</p>
			<h1 class="display-1">Networks, infrastructure, and the decisions behind them.</h1>
			<p class="lead">
				I use practical projects to understand how systems behave: how sites connect, where security boundaries belong, what should fail over, and what can be automated. I keep the diagrams, configuration, and reasoning together so the work can be understood and reused.
			</p>
			<div class="engineering-note" aria-label="Engineering areas">
				<span>Cisco network architecture</span>
				<span>Infrastructure automation</span>
				<span>Documented reasoning</span>
			</div>
		</div>
	</section>

	<section class="project-section" aria-labelledby="project-section-title">
		<div class="shell">
			<header class="collection-heading" data-reveal>
				<div>
					<p class="section-label">Network & infrastructure</p>
					<h2 id="project-section-title">Built as complete systems.</h2>
				</div>
				<p>Each project keeps the topology, technical choices, and validation context in one place.</p>
			</header>

			<div class="project-list">
				{engineeringProjects.map((project, index) => (
					<article class="eng-project" data-reveal>
						<a
							class:list={[
								'eng-project-media',
								project.image ? 'eng-project-media--topology' : 'eng-project-media--automation',
							]}
							href={`/engineering/${project.slug}/`}
							aria-label={`Open ${project.name}`}
						>
							{project.image ? (
								<img
									src={project.image}
									alt={`${project.name} topology`}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="automation-preview" aria-hidden="true">
									{project.systemFlow?.map((stage, stageIndex) => (
										<div class="automation-stage">
											<span>0{stageIndex + 1}</span>
											<div>
												<strong>{stage.label}</strong>
												<small>{stage.items.join(' · ')}</small>
											</div>
										</div>
									))}
								</div>
							)}
							<span class="project-index">0{index + 1}</span>
						</a>

						<div class="eng-project-copy">
							<p class="project-kicker">{project.category}</p>
							<h3><a href={`/engineering/${project.slug}/`}>{project.name}</a></h3>
							<p class="project-summary">{project.description}</p>
							<ul class="technology-list" aria-label={`Technologies used in ${project.name}`}>
								{project.technologies.slice(0, 6).map((technology) => <li>{technology}</li>)}
							</ul>
							<a class="text-link" href={`/engineering/${project.slug}/`}>
								Open project <span class="arr" aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	{collaborativeProject && (
		<section class="collaboration-section" aria-labelledby="collaboration-title">
			<div class="shell collaboration-layout">
				<header class="collaboration-heading" data-reveal>
					<p class="section-label">Collaborative engineering</p>
					<h2 id="collaboration-title">GalileoEngine is team work.</h2>
					<p>I build it with two co-founders. Ownership and the important decisions are shared across the team.</p>
				</header>

				<a
					class="team-project"
					href={collaborativeProject.url}
					target="_blank"
					rel="noreferrer"
					data-reveal
				>
					<div class="team-project-copy">
						<div class="team-meta">
							<span>{collaborativeProject.type}</span>
							{collaborativeProject.status && <span>{collaborativeProject.status}</span>}
						</div>
						<h3>{collaborativeProject.name}</h3>
						<p>{collaborativeProject.description}</p>
						<span class="text-link">
							{collaborativeProject.linkLabel ?? 'Visit the project'} <span class="arr" aria-hidden="true">↗</span>
						</span>
					</div>
					{collaborativeProject.logo && (
						<div class="team-project-mark" aria-hidden="true">
							<img src={collaborativeProject.logo} alt="" width="384" height="384" loading="lazy" decoding="async" />
						</div>
					)}
				</a>
			</div>
		</section>
	)}

	{experiments.length > 0 && (
		<section class="experiments-section" aria-labelledby="experiments-title">
			<div class="shell experiments-layout">
				<header class="experiments-heading" data-reveal>
					<p class="section-label">Small experiments</p>
					<h2 id="experiments-title">Ideas I test in code.</h2>
				</header>

				<div class="experiment-list">
					{experiments.map((experiment, index) => (
						<a
							class="experiment-item"
							href={experiment.url}
							target="_blank"
							rel="noreferrer"
							data-reveal
							style={`--reveal-delay:${index * 0.06}s`}
						>
							<span class="experiment-index">0{index + 1}</span>
							<div>
								<p>{experiment.type}</p>
								<h3>{experiment.name}</h3>
								<span>{experiment.description}</span>
							</div>
							<span class="experiment-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</div>
		</section>
	)}
</BaseLayout>

<style>
	.engineering-hero {
		display: grid;
		gap: 1.05rem;
	}

	.engineering-hero .display-1 {
		max-width: 18ch;
	}

	.engineering-hero .lead {
		max-width: 66ch;
	}

	.engineering-note,
	.team-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.25rem;
		margin-top: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-faint);
	}

	.engineering-note span,
	.team-meta span {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.engineering-note span::before,
	.team-meta span::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.72;
	}

	.project-section {
		padding: clamp(1.25rem, 2vw, 2rem) 0 clamp(4.5rem, 8vw, 7rem);
	}

	.collection-heading {
		display: grid;
		grid-template-columns: minmax(250px, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
		padding-bottom: clamp(2.4rem, 5vw, 4rem);
	}

	.section-label,
	.project-kicker {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	.collection-heading h2,
	.collaboration-heading h2,
	.experiments-heading h2 {
		margin-top: 1rem;
		font-size: clamp(1.8rem, 3.4vw, 2.8rem);
		letter-spacing: -0.035em;
	}

	.collection-heading > p,
	.collaboration-heading > p {
		max-width: 54ch;
		font-size: 0.98rem;
		color: var(--text-soft);
	}

	.project-list {
		display: grid;
	}

	.eng-project {
		position: relative;
		display: grid;
		grid-template-columns: minmax(320px, 0.88fr) minmax(0, 1.12fr);
		gap: clamp(2.5rem, 6vw, 5.25rem);
		align-items: center;
		padding: clamp(2.5rem, 5vw, 4rem) 0;
	}

	.eng-project::before,
	.eng-project:last-child::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--line-strong) 10%, var(--line) 90%, transparent);
	}

	.eng-project::before {
		top: 0;
	}

	.eng-project:last-child::after {
		bottom: 0;
	}

	.eng-project-media {
		position: relative;
		display: block;
		width: 100%;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--line-strong) 82%, transparent);
		border-radius: 1.35rem;
		background: color-mix(in srgb, var(--surface) 68%, transparent);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.025),
			0 22px 48px -42px rgba(0, 0, 0, 0.85);
	}

	.eng-project-media--topology {
		aspect-ratio: 16 / 9;
	}

	.eng-project-media--automation {
		min-height: 15rem;
		aspect-ratio: 16 / 9;
	}

	.eng-project-media:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 4px;
	}

	.eng-project-media img {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		background: #e4e7e9;
		filter: saturate(0.88) contrast(0.96) brightness(0.96);
		transition: transform 0.5s var(--ease), filter 0.5s var(--ease);
	}

	.eng-project-media:hover img,
	.eng-project-media:focus-visible img {
		transform: scale(1.025);
		filter: saturate(0.98) contrast(1) brightness(1);
	}

	.project-index {
		position: absolute;
		top: 1rem;
		left: 1rem;
		z-index: 3;
		padding: 0.32rem 0.62rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(10px);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		color: var(--text-soft);
	}

	.automation-preview {
		position: absolute;
		inset: 0;
		display: grid;
		align-content: center;
		gap: 0.85rem;
		padding: clamp(2.6rem, 5vw, 3.5rem) clamp(1.2rem, 3vw, 2rem) 1.25rem;
		background:
			linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
			color-mix(in srgb, var(--surface) 46%, transparent);
		background-size: 28px 28px, 28px 28px, auto;
	}

	.automation-stage {
		position: relative;
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		gap: 0.8rem;
		align-items: start;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 0.8rem;
		background: color-mix(in srgb, var(--bg-raised) 72%, transparent);
	}

	.automation-stage:not(:last-child)::after {
		content: '';
		position: absolute;
		left: 1.8rem;
		bottom: -0.9rem;
		width: 1px;
		height: 0.9rem;
		background: var(--line-strong);
	}

	.automation-stage > span {
		padding-top: 0.12rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: var(--text-faint);
	}

	.automation-stage strong,
	.automation-stage small {
		display: block;
	}

	.automation-stage strong {
		font-family: var(--font-display);
		font-size: 0.84rem;
		color: var(--text);
	}

	.automation-stage small {
		margin-top: 0.2rem;
		font-family: var(--font-mono);
		font-size: 0.61rem;
		line-height: 1.45;
		color: var(--text-faint);
	}

	.eng-project-copy {
		display: grid;
		justify-items: start;
		align-content: center;
		gap: 0.85rem;
	}

	.eng-project-copy h3 {
		font-size: clamp(1.55rem, 2.6vw, 2rem);
		letter-spacing: -0.035em;
	}

	.eng-project-copy h3 a {
		color: inherit;
	}

	.eng-project-copy h3 a:hover {
		color: var(--text-soft);
	}

	.project-summary {
		max-width: 57ch;
		font-size: 1rem;
		color: var(--text-soft);
		text-wrap: pretty;
	}

	.technology-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.75rem;
		margin: 0.2rem 0 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.02em;
		color: var(--text-faint);
	}

	.technology-list li {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		white-space: nowrap;
	}

	.technology-list li + li::before {
		content: '·';
		color: var(--text-faint);
	}

	.collaboration-section,
	.experiments-section {
		position: relative;
	}

	.collaboration-section {
		padding: clamp(4rem, 8vw, 7rem) 0;
	}

	.collaboration-section::before,
	.experiments-section::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		width: min(var(--shell), calc(100% - 2.5rem));
		height: 1px;
		transform: translateX(-50%);
		background: linear-gradient(90deg, transparent, var(--line-strong) 12%, var(--line) 88%, transparent);
	}

	.collaboration-layout {
		display: grid;
		grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 8vw, 7rem);
		align-items: center;
	}

	.collaboration-heading h2 {
		max-width: 12ch;
	}

	.collaboration-heading > p {
		margin-top: 1rem;
	}

	.team-project {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		min-height: 17rem;
		padding: clamp(1.6rem, 4vw, 2.5rem);
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--line-strong) 78%, transparent);
		border-radius: 1.5rem;
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--surface-strong) 54%, transparent),
			color-mix(in srgb, var(--surface) 28%, transparent)
		);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.025),
			0 22px 48px -42px rgba(0, 0, 0, 0.82);
		transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
	}

	.team-project:hover,
	.team-project:focus-visible {
		border-color: var(--line-strong);
		background: linear-gradient(145deg, var(--surface-strong), color-mix(in srgb, var(--surface) 52%, transparent));
	}

	.team-project:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 4px;
	}

	.team-project-copy {
		display: grid;
		justify-items: start;
		gap: 0.9rem;
	}

	.team-project h3 {
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		letter-spacing: -0.035em;
	}

	.team-project p {
		max-width: 57ch;
		font-size: 0.98rem;
		color: var(--text-soft);
	}

	.team-meta {
		margin-top: 0;
	}

	.team-project-mark {
		display: grid;
		place-items: center;
		width: clamp(7.5rem, 12vw, 9.5rem);
		aspect-ratio: 1;
	}

	.team-project-mark img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0.86;
		filter: saturate(0.88) drop-shadow(0 18px 24px rgba(0, 0, 0, 0.22));
		transition: opacity 0.3s var(--ease), transform 0.4s var(--ease);
	}

	.team-project:hover .team-project-mark img,
	.team-project:focus-visible .team-project-mark img {
		opacity: 0.96;
		transform: scale(1.025);
	}

	.experiments-section {
		padding: clamp(4rem, 8vw, 7rem) 0 clamp(4.5rem, 9vw, 8rem);
	}

	.experiments-layout {
		display: grid;
		grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(3rem, 9vw, 8rem);
		align-items: start;
	}

	.experiments-heading h2 {
		max-width: 10ch;
	}

	.experiment-list {
		display: grid;
	}

	.experiment-item {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: start;
		padding: 1.5rem 0 1.7rem;
	}

	.experiment-item::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, var(--line-strong), var(--line) 72%, transparent);
	}

	.experiment-item:last-child::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: linear-gradient(90deg, var(--line), transparent);
	}

	.experiment-index,
	.experiment-item p {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-faint);
	}

	.experiment-index {
		padding-top: 0.2rem;
	}

	.experiment-item p {
		margin-bottom: 0.45rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.experiment-item h3 {
		margin-bottom: 0.4rem;
		font-size: 1.2rem;
	}

	.experiment-item div > span {
		display: block;
		max-width: 56ch;
		font-size: 0.92rem;
		color: var(--text-soft);
	}

	.experiment-arrow {
		padding-top: 0.15rem;
		color: var(--text-faint);
		transition: transform 0.25s var(--ease), color 0.25s var(--ease);
	}

	.experiment-item:hover .experiment-arrow,
	.experiment-item:focus-visible .experiment-arrow {
		color: var(--text);
		transform: translate(2px, -2px);
	}

	:global(:root[data-theme='light']) .eng-project-media,
	:global(:root[data-theme='light']) .team-project {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.55),
			0 20px 42px -38px rgba(38, 42, 47, 0.24);
	}

	:global(:root[data-theme='light']) .automation-preview {
		background:
			linear-gradient(rgba(28, 31, 35, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(28, 31, 35, 0.035) 1px, transparent 1px),
			color-mix(in srgb, var(--surface) 46%, transparent);
		background-size: 28px 28px, 28px 28px, auto;
	}

	@media (max-width: 920px) {
		.eng-project,
		.collaboration-layout,
		.experiments-layout {
			grid-template-columns: 1fr;
		}

		.eng-project {
			gap: 1.75rem;
		}

		.collaboration-layout,
		.experiments-layout {
			gap: 2.5rem;
		}

		.collection-heading {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			align-items: start;
		}
	}

	@media (max-width: 620px) {
		.engineering-note {
			gap: 0.5rem 1rem;
		}

		.eng-project {
			padding: 2.8rem 0;
		}

		.eng-project-media {
			border-radius: 1.1rem;
		}

		.eng-project-media--automation {
			min-height: 12rem;
		}

		.project-index {
			top: 0.75rem;
			left: 0.75rem;
		}

		.automation-preview {
			gap: 0.65rem;
			padding: 2.7rem 0.85rem 0.85rem;
			background-size: 24px 24px, 24px 24px, auto;
		}

		.automation-stage {
			grid-template-columns: 1.75rem minmax(0, 1fr);
			gap: 0.55rem;
			padding: 0.55rem 0.65rem;
		}

		.automation-stage:not(:last-child)::after {
			left: 1.35rem;
			bottom: -0.7rem;
			height: 0.7rem;
		}

		.team-project {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 1.25rem;
			min-height: 0;
			padding: 1.35rem;
			border-radius: 1.25rem;
		}

		.team-project-mark {
			width: 4.75rem;
		}

		.team-meta {
			gap: 0.45rem 0.8rem;
		}

		.experiment-item {
			grid-template-columns: 2rem minmax(0, 1fr) auto;
			gap: 0.75rem;
		}
	}

	@media (max-width: 390px) {
		.team-project {
			grid-template-columns: 1fr;
		}

		.team-project-mark {
			grid-row: 1;
			width: 4.5rem;
		}
	}
</style>
