---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppMark from '../../components/AppMark.astro';
import { products } from '../../data/site';
---

<BaseLayout
	title="Products"
	description="Open-source Windows tools for diagnostics, network support, and printer operations — built by Ionel Silviu Ghimpau."
>
	<section class="page-hero">
		<div class="shell product-hero" data-reveal>
			<p class="eyebrow">Products</p>
			<h1 class="display-1">Tools I built for everyday support work.</h1>
			<p class="lead">
				Each one started with a task I wanted to make clearer: checking a Windows machine, tracing a network problem, or working through printer support. They stay focused, practical, and open source.
			</p>
			<div class="product-note" aria-label="Product availability">
				<span>Windows 10 / 11</span>
				<span>Source on GitHub</span>
				<span>Portable releases</span>
			</div>
		</div>
	</section>

	<section class="products-section" aria-label="Applications">
		<div class="shell product-list">
			{products.map((product, index) => (
				<article class="product-entry" data-reveal>
					<div class="product-visual" aria-hidden="true">
						<div class="product-mark-stage">
							<AppMark
								src={product.logo}
								variant={product.slug === 'isg-desk' ? 'wordmark' : 'icon'}
							/>
						</div>
					</div>

					<div class="product-copy">
						<p class="product-kicker">{product.kicker}</p>
						<div class="product-title-row">
							<h2>{product.name}</h2>
							<p class="product-meta">
								<span>0{index + 1}</span>
								<span>v{product.version} · {product.status}</span>
								<span>{product.platform}</span>
							</p>
						</div>
						<p class="product-summary">{product.description}</p>
						<ul class="capability-list">
							{product.features.slice(0, 3).map((feature) => <li>{feature}</li>)}
						</ul>
						<div class="product-actions">
							<a class="btn btn-primary btn-sm" href={`/products/${product.slug}/`}>
								See how it works <span class="arr" aria-hidden="true">→</span>
							</a>
							<a class="text-link" href={product.repository} target="_blank" rel="noreferrer">
								Source on GitHub <span class="arr" aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="product-method" aria-labelledby="product-method-title">
		<div class="shell product-method-layout">
			<div class="method-heading" data-reveal>
				<p class="method-label">How I build them</p>
				<h2 id="product-method-title">Useful first, easy to understand.</h2>
			</div>
			<ol class="method-list">
				<li data-reveal>
					<span>01</span>
					<div><h3>One clear job</h3><p>I keep each tool close to a real technician workflow.</p></div>
				</li>
				<li data-reveal style="--reveal-delay:.06s">
					<span>02</span>
					<div><h3>Evidence before action</h3><p>The result should show what was checked and why it matters.</p></div>
				</li>
				<li data-reveal style="--reveal-delay:.12s">
					<span>03</span>
					<div><h3>Public by default</h3><p>The source, releases, current status, and limitations stay open to inspection.</p></div>
				</li>
			</ol>
		</div>
	</section>
</BaseLayout>

<style>
	.product-hero {
		display: grid;
		gap: 1.05rem;
	}

	.product-hero .display-1 {
		max-width: 17ch;
	}

	.product-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.25rem;
		margin-top: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-faint);
	}

	.product-note span {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.product-note span::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.72;
	}

	.products-section {
		padding: clamp(1rem, 2vw, 1.75rem) 0 clamp(4.5rem, 8vw, 7rem);
	}

	.product-list {
		display: grid;
	}

	.product-entry {
		position: relative;
		display: grid;
		grid-template-columns: minmax(170px, 0.45fr) minmax(0, 1.55fr);
		gap: clamp(2.25rem, 5.5vw, 4.5rem);
		align-items: center;
		padding: clamp(2.25rem, 4.5vw, 3.5rem) 0;
	}

	.product-entry::before,
	.product-entry:last-child::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--line-strong) 10%, var(--line) 90%, transparent);
	}

	.product-entry::before {
		top: 0;
	}

	.product-entry:last-child::after {
		bottom: 0;
	}

	.product-visual {
		position: relative;
		display: grid;
		place-items: center;
		justify-self: center;
		width: min(100%, 13.25rem);
		min-height: 10.5rem;
		padding: 1.1rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--line-strong) 78%, transparent);
		border-radius: 1.35rem;
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--surface-strong) 48%, transparent),
			color-mix(in srgb, var(--surface) 22%, transparent)
		);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.025),
			0 18px 40px -36px rgba(0, 0, 0, 0.85);
	}

	.product-visual::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.018), transparent 46%);
		pointer-events: none;
	}

	.product-mark-stage {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
	}

	:global(:root[data-theme='light']) .product-visual {
		border-color: color-mix(in srgb, var(--line-strong) 58%, transparent);
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--surface-strong) 34%, transparent),
			color-mix(in srgb, var(--surface) 16%, transparent)
		);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.55),
			0 18px 40px -36px rgba(38, 42, 47, 0.26);
	}

	.product-mark-stage :global(.app-mark::before) {
		display: none;
	}

	.product-mark-stage :global(.app-mark-surface) {
		width: 7rem;
		padding: 0.25rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

	.product-mark-stage :global(.app-mark-surface::before) {
		display: none;
	}

	.product-mark-stage :global(.app-mark img) {
		border-radius: 0.7rem;
		filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.2));
	}

	.product-mark-stage :global(.app-mark--wordmark .app-mark-surface) {
		width: 10rem;
		aspect-ratio: 1.65;
		padding: 0;
	}

	.product-mark-stage :global(.app-mark--wordmark img) {
		border: 0;
		border-radius: 0.85rem;
		filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.2));
	}

	.product-copy {
		display: grid;
		justify-items: start;
		align-content: center;
		gap: 0.85rem;
	}

	.product-kicker,
	.method-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	.product-copy h2 {
		font-size: clamp(1.55rem, 2.5vw, 1.9rem);
		letter-spacing: -0.035em;
	}

	.product-title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.55rem 1.5rem;
		width: 100%;
	}

	.product-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.03em;
		color: var(--text-faint);
	}

	.product-meta span {
		white-space: nowrap;
	}

	.product-meta span + span::before {
		content: '·';
		margin-right: 0.7rem;
		color: var(--text-faint);
	}

	.product-summary {
		max-width: 58ch;
		font-size: 1rem;
		color: var(--text-soft);
		text-wrap: pretty;
	}

	.capability-list {
		display: grid;
		gap: 0.45rem;
		margin-top: 0.15rem;
	}

	.capability-list li {
		position: relative;
		padding-left: 1.25rem;
		font-size: 0.92rem;
		color: var(--text-soft);
	}

	.capability-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 5px;
		height: 5px;
		border-radius: 1px;
		background: var(--text-faint);
		transform: translateY(-50%);
	}

	.product-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem 1rem;
		margin-top: 0.45rem;
	}

	.product-method {
		position: relative;
		padding: clamp(3.75rem, 7vw, 6rem) 0 clamp(4.5rem, 8vw, 7rem);
	}

	.product-method::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		width: min(var(--shell), calc(100% - 2.5rem));
		height: 1px;
		transform: translateX(-50%);
		background: linear-gradient(90deg, transparent, var(--line-strong) 12%, var(--line) 88%, transparent);
	}

	.product-method-layout {
		display: grid;
		grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
		gap: clamp(3rem, 9vw, 8rem);
		align-items: start;
	}

	.method-heading h2 {
		max-width: 13ch;
		margin-top: 1.1rem;
		font-size: clamp(1.8rem, 3.4vw, 2.8rem);
		letter-spacing: -0.035em;
	}

	.method-list {
		display: grid;
	}

	.method-list li {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: 1rem;
		padding: 1.45rem 0 1.65rem;
	}

	.method-list li::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, var(--line-strong), var(--line) 72%, transparent);
	}

	.method-list li:last-child::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: linear-gradient(90deg, var(--line), transparent);
	}

	.method-list li > span {
		padding-top: 0.18rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-faint);
	}

	.method-list h3 {
		margin-bottom: 0.4rem;
		font-size: 1.12rem;
	}

	.method-list p {
		max-width: 54ch;
		font-size: 0.94rem;
		color: var(--text-soft);
	}

	@media (max-width: 820px) {
		.product-entry,
		.product-method-layout {
			grid-template-columns: 1fr;
		}

		.product-entry {
			gap: 1.25rem;
		}

		.product-visual {
			width: min(100%, 12.75rem);
			min-height: 9.75rem;
			padding: 1rem;
			justify-self: start;
			place-items: center;
		}

		.product-method-layout {
			gap: 2.5rem;
		}
	}

	@media (max-width: 480px) {
		.product-note {
			gap: 0.5rem 1rem;
		}

		.product-entry {
			padding: 2.8rem 0;
		}

		.product-actions {
			align-items: stretch;
			width: 100%;
		}

		.product-actions .btn {
			width: 100%;
		}

		.product-actions .text-link {
			justify-content: center;
			padding: 0.5rem;
		}
	}
</style>
