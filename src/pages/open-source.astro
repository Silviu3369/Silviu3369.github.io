---
import BaseLayout from '../layouts/BaseLayout.astro';
import { engineeringProjects, labProjects, products, site } from '../data/site';

const groups = [
	{
		id: 'products',
		label: 'Products',
		description: 'Windows tools I maintain for practical support and diagnostics.',
		noun: 'repositories',
		items: products.map((product) => ({
			name: product.name,
			description: product.description,
			url: product.repository,
			meta: `v${product.version}`,
		})),
	},
	{
		id: 'engineering',
		label: 'Engineering',
		description: 'Network designs, topology files, configuration, and infrastructure automation.',
		noun: 'repositories',
		items: engineeringProjects.map((project) => ({
			name: project.name,
			description: project.description,
			url: project.repository,
			meta: project.category,
		})),
	},
	{
		id: 'collaborative-experiments',
		label: 'Collaborative & experiments',
		description: 'Team work and smaller ideas that I continue to explore in code.',
		noun: 'projects',
		items: labProjects.map((project) => ({
			name: project.name,
			description: project.description,
			url: project.url,
			meta: project.type,
		})),
	},
];
---

<BaseLayout
	title="Open Source"
	description="Open-source products, engineering projects, and collaborative browser systems work involving Ionel Silviu Ghimpau."
>
	<section class="page-hero">
		<div class="shell open-source-hero" data-reveal>
			<p class="eyebrow">Open Source</p>
			<h1 class="display-1">I publish the code behind the things I build.</h1>
			<p class="lead">
				The finished interface is only one part of a project. I keep the source, release history, and technical notes public so the decisions can be understood, the changes can be followed, and useful parts can be reused.
			</p>
			<div class="open-source-note" aria-label="What is publicly available">
				<span>Source code</span>
				<span>Change history</span>
				<span>Working releases</span>
			</div>
		</div>
	</section>

	<section class="principles-section" aria-labelledby="principles-title">
		<div class="shell principles-layout">
			<header class="principles-heading" data-reveal>
				<p class="section-label">Why I publish</p>
				<h2 id="principles-title">Open enough to be useful.</h2>
				<p>A public project should be understandable, not simply downloadable.</p>
			</header>

			<ol class="principles-list">
				<li data-reveal>
					<span>01</span>
					<div>
						<h3>Show how it works</h3>
						<p>The structure and technical choices remain visible beyond the final interface.</p>
					</div>
				</li>
				<li data-reveal style="--reveal-delay:.06s">
					<span>02</span>
					<div>
						<h3>Keep changes visible</h3>
						<p>Commits, releases, and issues give each project an honest history.</p>
					</div>
				</li>
				<li data-reveal style="--reveal-delay:.12s">
					<span>03</span>
					<div>
						<h3>Make reuse practical</h3>
						<p>Others can inspect an idea, adapt what helps, or point out what can improve.</p>
					</div>
				</li>
			</ol>
		</div>
	</section>

	<section class="repositories-section" aria-labelledby="repositories-title">
		<div class="shell">
			<header class="collection-heading" data-reveal>
				<div>
					<p class="section-label">Public work</p>
					<h2 id="repositories-title">Grouped by what it does.</h2>
				</div>
				<p>Products, infrastructure work, and ongoing experiments each have a different purpose, so I keep that distinction clear.</p>
			</header>

			<div class="repository-groups">
				{groups.map((group) => (
					<section class="repository-group" aria-labelledby={`${group.id}-title`} data-reveal>
						<header class="repository-group-head">
							<div>
								<h3 id={`${group.id}-title`}>{group.label}</h3>
								<p>{group.description}</p>
							</div>
							<span>{String(group.items.length).padStart(2, '0')} {group.noun}</span>
						</header>

						<ul class="repository-list">
							{group.items.map((item, index) => (
								<li>
									<a href={item.url} target="_blank" rel="noreferrer">
										<span class="repository-index">{String(index + 1).padStart(2, '0')}</span>
										<div class="repository-copy">
											<strong>{item.name}</strong>
											<p>{item.description}</p>
										</div>
										<span class="repository-meta">{item.meta}</span>
										<span class="repository-arrow" aria-hidden="true">↗</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</div>
	</section>

	<section class="github-section" aria-labelledby="github-title">
		<div class="shell github-callout" data-reveal>
			<div>
				<p class="section-label">GitHub</p>
				<h2 id="github-title">Everything starts with the repository.</h2>
				<p>Browse the source, current releases, open issues, and the work still in progress.</p>
			</div>
			<a class="btn btn-primary" href={site.github} target="_blank" rel="noreferrer">
				Open my GitHub <span class="arr arr-ext" aria-hidden="true">↗</span>
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.open-source-hero {
		display: grid;
		gap: 1.05rem;
	}

	.open-source-hero .display-1 {
		max-width: 17ch;
	}

	.open-source-hero .lead {
		max-width: 66ch;
	}

	.open-source-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.25rem;
		margin-top: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--text-faint);
	}

	.open-source-note span {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.open-source-note span::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.72;
	}

	.principles-section {
		padding: clamp(2rem, 4vw, 3rem) 0 clamp(4.5rem, 8vw, 7rem);
	}

	.principles-layout {
		display: grid;
		grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 9vw, 8rem);
		align-items: start;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	.principles-heading h2,
	.collection-heading h2,
	.github-callout h2 {
		margin-top: 1rem;
		font-size: clamp(1.8rem, 3.4vw, 2.8rem);
		letter-spacing: -0.035em;
	}

	.principles-heading h2 {
		max-width: 10ch;
	}

	.principles-heading > p:last-child {
		max-width: 42ch;
		margin-top: 1rem;
		font-size: 0.96rem;
		color: var(--text-soft);
	}

	.principles-list {
		display: grid;
	}

	.principles-list li {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: 1rem;
		padding: 1.45rem 0 1.65rem;
	}

	.principles-list li::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, var(--line-strong), var(--line) 72%, transparent);
	}

	.principles-list li:last-child::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: linear-gradient(90deg, var(--line), transparent);
	}

	.principles-list li > span {
		padding-top: 0.18rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-faint);
	}

	.principles-list h3 {
		margin-bottom: 0.4rem;
		font-size: 1.12rem;
	}

	.principles-list p {
		max-width: 54ch;
		font-size: 0.94rem;
		color: var(--text-soft);
	}

	.repositories-section {
		position: relative;
		padding: clamp(4rem, 8vw, 7rem) 0;
	}

	.repositories-section::before,
	.github-section::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		width: min(var(--shell), calc(100% - 2.5rem));
		height: 1px;
		transform: translateX(-50%);
		background: linear-gradient(90deg, transparent, var(--line-strong) 12%, var(--line) 88%, transparent);
	}

	.collection-heading {
		display: grid;
		grid-template-columns: minmax(250px, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
		padding-bottom: clamp(2.75rem, 5vw, 4.25rem);
	}

	.collection-heading > p {
		max-width: 54ch;
		font-size: 0.98rem;
		color: var(--text-soft);
	}

	.repository-groups {
		display: grid;
		gap: clamp(3.5rem, 7vw, 5.5rem);
	}

	.repository-group-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		padding-bottom: 1.25rem;
	}

	.repository-group-head h3 {
		font-size: clamp(1.35rem, 2.3vw, 1.7rem);
		letter-spacing: -0.03em;
	}

	.repository-group-head p {
		max-width: 58ch;
		margin-top: 0.45rem;
		font-size: 0.9rem;
		color: var(--text-soft);
	}

	.repository-group-head > span,
	.repository-index,
	.repository-meta {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.03em;
		color: var(--text-faint);
	}

	.repository-group-head > span {
		padding-bottom: 0.1rem;
		white-space: nowrap;
	}

	.repository-list {
		display: grid;
	}

	.repository-list li {
		position: relative;
	}

	.repository-list li::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, var(--line-strong), var(--line) 80%, transparent);
	}

	.repository-list li:last-child::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: linear-gradient(90deg, var(--line), transparent);
	}

	.repository-list a {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) minmax(8rem, 0.36fr) auto;
		gap: clamp(0.85rem, 2.5vw, 1.6rem);
		align-items: start;
		padding: 1.35rem 0 1.55rem;
		transition: opacity 0.2s var(--ease);
	}

	.repository-list a:hover {
		opacity: 0.78;
	}

	.repository-list a:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 5px;
	}

	.repository-index {
		padding-top: 0.22rem;
	}

	.repository-copy {
		display: grid;
		gap: 0.38rem;
		min-width: 0;
	}

	.repository-copy strong {
		font-family: var(--font-display);
		font-size: 1.08rem;
		line-height: 1.3;
	}

	.repository-copy p {
		max-width: 64ch;
		font-size: 0.9rem;
		color: var(--text-soft);
		text-wrap: pretty;
	}

	.repository-meta {
		padding-top: 0.22rem;
		line-height: 1.5;
	}

	.repository-arrow {
		padding-top: 0.08rem;
		color: var(--text-faint);
		transition: transform 0.25s var(--ease), color 0.25s var(--ease);
	}

	.repository-list a:hover .repository-arrow,
	.repository-list a:focus-visible .repository-arrow {
		color: var(--text);
		transform: translate(2px, -2px);
	}

	.github-section {
		position: relative;
		padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(4.5rem, 9vw, 7.5rem);
	}

	.github-callout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2.5rem;
		align-items: center;
	}

	.github-callout h2 {
		max-width: 16ch;
	}

	.github-callout div > p:last-child {
		max-width: 54ch;
		margin-top: 0.85rem;
		font-size: 0.96rem;
		color: var(--text-soft);
	}

	@media (max-width: 860px) {
		.principles-layout,
		.collection-heading {
			grid-template-columns: 1fr;
		}

		.principles-layout {
			gap: 2.5rem;
		}

		.collection-heading {
			gap: 1.25rem;
			align-items: start;
		}

		.repository-list a {
			grid-template-columns: 2.25rem minmax(0, 1fr) auto;
		}

		.repository-meta {
			grid-column: 2;
			grid-row: 2;
			padding-top: 0;
		}

		.repository-arrow {
			grid-column: 3;
			grid-row: 1 / span 2;
		}
	}

	@media (max-width: 620px) {
		.open-source-note {
			gap: 0.5rem 1rem;
		}

		.repository-group-head {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}

		.repository-list a {
			grid-template-columns: 1.9rem minmax(0, 1fr) auto;
			gap: 0.7rem;
			padding: 1.3rem 0 1.45rem;
		}

		.github-callout {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.github-callout .btn {
			width: fit-content;
		}
	}

	@media (max-width: 390px) {
		.repository-meta {
			display: none;
		}
	}
</style>
