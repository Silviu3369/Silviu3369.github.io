---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex={true}>
	<section class="not-found">
		<div class="shell nf-inner" data-reveal>
			<span class="nf-code grad-text">404</span>
			<h1 class="display-2">I couldn’t find that page.</h1>
			<p class="lead">The link may be old, or the address may have a typo. The home page is a good place to start again.</p>
			<a class="btn btn-primary" href="/">Go back home <span class="arr" aria-hidden="true">→</span></a>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		min-height: 82vh;
		display: grid;
		align-items: center;
		padding-top: var(--header-h);
	}

	.nf-inner {
		display: grid;
		gap: 1.2rem;
		justify-items: center;
		text-align: center;
	}

	.nf-code {
		font-family: var(--font-display);
		font-size: clamp(5rem, 14vw, 8rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.nf-inner .lead {
		max-width: 38ch;
	}

	.nf-inner .btn {
		margin-top: 0.6rem;
	}
</style>
