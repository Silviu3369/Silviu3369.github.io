---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<section class="home-hero">
		<div class="shell home-hero-inner" data-reveal>
			<p class="home-kicker">Software <span>·</span> Networks <span>·</span> Open source</p>
			<h1>I build software, explore how systems work, and share what I learn.</h1>
			<p class="home-intro">
				Most projects begin with something I want to understand or make easier: diagnosing a Windows machine, designing a network, automating repetitive work, or helping build a browser engine with a small team.
			</p>
			<div class="home-actions">
				<a class="btn btn-primary" href="/products/">See the products <span class="arr" aria-hidden="true">→</span></a>
				<a class="btn btn-ghost" href="/engineering/">Explore engineering <span class="arr" aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="home-work" aria-labelledby="home-work-title">
		<div class="shell home-work-layout">
			<div class="home-section-heading" data-reveal>
				<p class="home-label">What I work on</p>
				<h2 id="home-work-title">A mix of software and engineering.</h2>
			</div>

			<div class="work-list">
				<a href="/products/" data-reveal>
					<span class="work-number">01</span>
					<div>
						<h3>Practical software</h3>
						<p>Windows tools shaped around diagnosis, support work, and clear results.</p>
					</div>
					<span class="work-arrow" aria-hidden="true">→</span>
				</a>
				<a href="/engineering/" data-reveal style="--reveal-delay:.06s">
					<span class="work-number">02</span>
					<div>
						<h3>Networks and infrastructure</h3>
						<p>Cisco architecture, automation, and the decisions behind the work.</p>
					</div>
					<span class="work-arrow" aria-hidden="true">→</span>
				</a>
				<a href="/open-source/" data-reveal style="--reveal-delay:.12s">
					<span class="work-number">03</span>
					<div>
						<h3>Open-source work</h3>
						<p>Public code, releases, and browser-engine work shared with a small team.</p>
					</div>
					<span class="work-arrow" aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="home-reason" aria-labelledby="home-reason-title">
		<div class="shell home-reason-layout">
			<div data-reveal>
				<p class="home-label">Why I do it</p>
				<h2 id="home-reason-title">Building is how I learn.</h2>
			</div>
			<div class="reason-copy" data-reveal style="--reveal-delay:.06s">
				<p>I like taking a problem apart, understanding the pieces, and putting them back together in a way that is easier to use and explain.</p>
				<p>Keeping the source and the reasoning public leaves a useful record, makes the work easier to improve, and gives other people something real to inspect.</p>
				<a class="text-link" href="/open-source/">See the open-source work <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.home-hero {
		position: relative;
		min-height: min(700px, 76vh);
		display: flex;
		align-items: center;
		padding: calc(var(--header-h) + 3.25rem) 0 4.5rem;
	}

	.home-hero::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 0;
		width: min(var(--shell), calc(100% - 2.5rem));
		height: 1px;
		transform: translateX(-50%);
		background: linear-gradient(90deg, transparent, var(--line-strong) 10%, var(--line-strong) 90%, transparent);
	}

	.home-hero-inner {
		display: grid;
		justify-items: start;
	}

	.home-kicker,
	.home-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	.home-kicker {
		margin-bottom: clamp(1.4rem, 3vw, 2rem);
	}

	.home-kicker span {
		margin-inline: 0.45rem;
		color: var(--text-faint);
	}

	.home-hero h1 {
		max-width: 19ch;
		font-size: clamp(2.7rem, 5.6vw, 4.3rem);
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1.02;
		text-wrap: balance;
	}

	.home-intro {
		max-width: 700px;
		margin-top: clamp(1.5rem, 2.8vw, 2rem);
		font-size: clamp(1rem, 1.35vw, 1.12rem);
		line-height: 1.7;
		color: var(--text-soft);
		text-wrap: pretty;
	}

	.home-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.home-work,
	.home-reason {
		padding: clamp(4.5rem, 8vw, 7rem) 0;
	}

	.home-work-layout,
	.home-reason-layout {
		display: grid;
		grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
		gap: clamp(3rem, 9vw, 8rem);
		align-items: start;
	}

	.home-section-heading h2,
	.home-reason h2 {
		max-width: 13ch;
		margin-top: 1.1rem;
		font-size: clamp(1.8rem, 3.4vw, 2.8rem);
		letter-spacing: -0.035em;
	}

	.work-list {
		display: grid;
	}

	.work-list a {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: start;
		padding: 1.55rem 0 1.75rem;
		transition: padding 0.25s var(--ease), color 0.2s var(--ease);
	}

	.work-list a::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, var(--line-strong), var(--line) 72%, transparent);
	}

	.work-list a:last-child::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: linear-gradient(90deg, var(--line), transparent);
	}

	.work-list a:hover {
		padding-inline: 0.65rem;
	}

	.work-number {
		padding-top: 0.18rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-faint);
	}

	.work-list h3 {
		margin-bottom: 0.45rem;
		font-size: 1.15rem;
	}

	.work-list p,
	.reason-copy {
		color: var(--text-soft);
	}

	.work-list p {
		max-width: 54ch;
		font-size: 0.95rem;
	}

	.work-arrow {
		padding-top: 0.05rem;
		color: var(--text-faint);
		transition: transform 0.25s var(--ease), color 0.2s var(--ease);
	}

	.work-list a:hover .work-arrow {
		transform: translateX(3px);
		color: var(--text);
	}

	.home-reason {
		position: relative;
		padding-top: clamp(3.75rem, 7vw, 5.75rem);
	}

	.home-reason::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		width: min(var(--shell), calc(100% - 2.5rem));
		height: 1px;
		transform: translateX(-50%);
		background: linear-gradient(90deg, transparent, var(--line-strong) 12%, var(--line) 88%, transparent);
	}

	.reason-copy {
		display: grid;
		gap: 1.1rem;
		max-width: 620px;
	}

	.reason-copy p {
		text-wrap: pretty;
	}

	.reason-copy .text-link {
		justify-self: start;
		margin-top: 0.55rem;
		color: var(--text);
	}

	@media (max-width: 760px) {
		.home-hero {
			min-height: auto;
			padding: calc(var(--header-h) + 3.25rem) 0 4.25rem;
		}

		.home-hero h1 {
			max-width: 17ch;
			font-size: clamp(2.15rem, 10.3vw, 3.15rem);
			line-height: 1.04;
		}

		.home-intro {
			font-size: 1rem;
		}

		.home-work-layout,
		.home-reason-layout {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.home-section-heading h2,
		.home-reason h2 {
			max-width: 15ch;
		}

		.work-list a:hover {
			padding-inline: 0;
		}
	}

	@media (max-width: 480px) {
		.home-kicker {
			font-size: 0.68rem;
			letter-spacing: 0.09em;
			white-space: nowrap;
		}

		.home-kicker span {
			margin-inline: 0.3rem;
		}

		.home-actions {
			align-items: stretch;
			width: 100%;
		}

		.home-actions .btn {
			width: 100%;
		}

		.work-list a {
			grid-template-columns: 2rem minmax(0, 1fr) auto;
			gap: 0.75rem;
		}
	}
</style>
