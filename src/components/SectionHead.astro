---
interface Props {
	eyebrow: string;
	title: string;
	lead?: string;
	centered?: boolean;
}

const { eyebrow, title, lead, centered = false } = Astro.props;
---

<div class:list={['section-head', { centered }]} data-reveal>
	<p class="eyebrow">{eyebrow}</p>
	<h2 class="display-2" set:html={title} />
	{lead && <p class="lead">{lead}</p>}
</div>
